{
  "name": "@workstudio-plugins/text-editor",
  "version": "0.1.0",
  "private": true,
  "description": "WorkStudio plain text editor: byte-faithful encoding, line endings and config/log languages",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./workstudio": "./dist/engine.js"
  },
  "workstudio": {
    "id": "text-editor",
    "label": "纯文本编辑器",
    "icon": "file-text",
    "pages": {
      "content": "dist/page/index.html",
      "settings": "dist/settings/index.html"
    },
    "claims": [
      {
        "extensions": [
          "txt",
          "text",
          "log",
          "ini",
          "cfg",
          "conf",
          "properties",
          "env"
        ],
        "priority": 20
      },
      {
        "extensions": [
          "yaml",
          "yml",
          "toml"
        ],
        "priority": 20
      },
      {
        "extensions": [
          "json"
        ],
        "priority": 10
      }
    ],
    "skills": [
      "skills/text-editor"
    ]
  },
  "registry": {
    "description": "字节保真的纯文本 / 配置 / 日志编辑器：保留编码、BOM 与换行",
    "category": "开发",
    "tags": [
      "text",
      "editor",
      "config",
      "yaml",
      "toml",
      "log",
      "encoding"
    ]
  },
  "scripts": {
    "build": "vite build && vite build --config vite.engine.config.ts && workstudio-plugin .",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "pack:plugin": "node scripts/pack.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@work-studio/sdk": "0.1.0",
    "iconv-lite": "^0.7.3",
    "jschardet": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "fflate": "^0.8.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.2"
  }
}
